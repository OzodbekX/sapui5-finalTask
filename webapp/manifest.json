{
  "_version": "1.89.0",
  "sap.app": {
    "id": "project1",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "a835adfd-9ce5-44b8-b57d-784f2f5d6fb8"
    },
    "dataSources": {
      "mainService": {
        "uri": "/V2/Northwind/Northwind.svc/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "annotations": [],
          "localUri": "localService/metadata.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "project1.i18n.i18n"
        }
      },
      "odataV2": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "controlId": "layout",
        "type": "View",
        "viewType": "XML",
        "path": "project1.view",
        "async": true,
        "bypassed": {
          "target": ["master", "notFound"]
        }
      },

      "routes": [
        {
          "name": "master",
          "pattern": "",
          "target": ["master"]
        },
        {
          "name": "create",
          "pattern": "new",
          "target": ["master", "object"]
        },
        {
          "name": "object",
          "pattern": "Orders/{objectId}:?query:",
          "target": ["master", "object"]
        }
      ],
      "targets": {
        "master": {
          "id": "Master",
          "name": "Master",
          "level": 1,
          "controlAggregation": "beginColumnPages"
        },
        "object": {
          "id": "Detail",
          "name": "Detail",
          "level": 2,
          "controlAggregation": "midColumnPages"
        },
        "notFound": {
          "id": "NotFound",
          "name": "NotFound",
          "level": 2,
          "controlAggregation": "midColumnPages"
        }
      }
    },
    "rootView": {
      "viewName": "project1.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
