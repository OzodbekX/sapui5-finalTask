<mvc:View
    controllerName="project1.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <f:DynamicPage
        id="detailPage"
        toggleHeaderOnTitleClick="true"
        showFooter="{detailView>/editMode}"
    >
        <f:title>
            <f:DynamicPageTitle id="detailTitle">
                <f:heading>
                    <Title
                        id="detailHeading"
                        text="{i18n>order} {odataV2>OrderID}"
                    />
                </f:heading>
                <f:actions>
                    <Button
                        id="editOrderButton"
                        text="{i18n>edit}"
                        type="Emphasized"
                        press=".onEditOrder"
                        visible="{= !${detailView>/editMode} }"
                    />
                    <Button
                        id="deleteOrderButton"
                        text="{i18n>delete}"
                        type="Transparent"
                        press=".onDeleteOrder"
                        visible="{= !${detailView>/editMode} }"
                    />
                    <Button
                        id="emailButton"
                        icon="sap-icon://email"
                        type="Transparent"
                        tooltip="{i18n>sendEmail}"
                        press=".onSendEmail"
                        visible="{= !${detailView>/editMode} }"
                    />
                </f:actions>
                <f:navigationActions>
                    <Button
                        id="fullScreenButton"
                        type="Transparent"
                        icon="{= ${appView>/layout} === 'MidColumnFullScreen' ? 'sap-icon://exit-full-screen' : 'sap-icon://full-screen' }"
                        press=".onToggleFullScreen"
                    />
                    <Button
                        id="closeButton"
                        type="Transparent"
                        icon="sap-icon://decline"
                        press=".onCloseDetail"
                    />
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader
                id="detailHeader"
                pinnable="true"
                visible="{= !${detailView>/isNew} }"
            >
                <HBox
                    id="headerBox"
                    wrap="Wrap"
                >
                    <VBox
                        id="headerInfo"
                        class="sapUiMediumMarginEnd"
                    >
                        <ObjectAttribute
                            id="attrCustomer"
                            title="{i18n>customer}"
                            text="{odataV2>CustomerName}"
                        />
                        <ObjectAttribute
                            id="attrOrdered"
                            title="{i18n>ordered}"
                            text="{ path: 'odataV2>OrderDate', type: 'sap.ui.model.type.Date', formatOptions: { style: 'medium', UTC: true } }"
                        />
                        <ObjectAttribute
                            id="attrShipped"
                            title="{i18n>shipped}"
                            text="{ path: 'odataV2>ShippedDate', type: 'sap.ui.model.type.Date', formatOptions: { style: 'medium', UTC: true } }"
                        />
                    </VBox>
                    <VBox id="headerPrice">
                        <Label
                            id="priceLabel"
                            text="{i18n>price}"
                        />
                        <ObjectNumber
                            id="priceNumber"
                            emphasized="true"
                            unit="EUR"
                            number="{ path: 'detailView>/totalPrice', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }"
                        />
                    </VBox>
                </HBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox id="detailContent">
                <core:Fragment
                    fragmentName="project1.view.fragments.OrderForm"
                    type="XML"
                />
                <IconTabBar
                    id="iconTabBar"
                    selectedKey="shipping"
                    expandable="false"
                    class="sapUiResponsiveContentPadding"
                    visible="{= !${detailView>/editMode} }"
                >
                    <items>
                        <IconTabFilter
                            id="shippingTab"
                            key="shipping"
                            icon="sap-icon://shipping-status"
                            tooltip="{i18n>shippingAddress}"
                        >
                            <form:SimpleForm
                                id="shippingForm"
                                title="{i18n>shippingAddress}"
                                editable="false"
                                layout="ResponsiveGridLayout"
                                labelSpanL="3"
                                labelSpanM="3"
                                columnsL="1"
                                columnsM="1"
                            >
                                <Label
                                    id="lblShipName"
                                    text="{i18n>name}"
                                />
                                <Text
                                    id="txtShipName"
                                    text="{odataV2>ShipName}"
                                />
                                <Label
                                    id="lblStreet"
                                    text="{i18n>street}"
                                />
                                <Text
                                    id="txtStreet"
                                    text="{odataV2>ShipAddress}"
                                />
                                <Label
                                    id="lblZipCity"
                                    text="{i18n>zipCity}"
                                />
                                <Text
                                    id="txtZipCity"
                                    text="{odataV2>ShipPostalCode} {odataV2>ShipCity}"
                                />
                                <Label
                                    id="lblRegion"
                                    text="{i18n>region}"
                                />
                                <Text
                                    id="txtRegion"
                                    text="{odataV2>ShipRegion}"
                                />
                                <Label
                                    id="lblCountry"
                                    text="{i18n>country}"
                                />
                                <Text
                                    id="txtCountry"
                                    text="{odataV2>ShipCountry}"
                                />
                            </form:SimpleForm>
                        </IconTabFilter>

                        <IconTabFilter
                            id="processorTab"
                            key="processor"
                            icon="sap-icon://employee"
                            tooltip="{i18n>processorInformation}"
                        >
                            <form:SimpleForm
                                id="processorForm"
                                title="{i18n>processorInformation}"
                                editable="false"
                                layout="ResponsiveGridLayout"
                                labelSpanL="3"
                                labelSpanM="3"
                                columnsXL="2"
                                columnsL="2"
                                columnsM="2"
                            >
                                <core:Title
                                    id="detailsTitle"
                                    text="{i18n>details}"
                                />
                                <Label
                                    id="lblEmpName"
                                    text="{i18n>name}"
                                />
                                <Text
                                    id="txtEmpName"
                                    text="{odataV2>Employee/FirstName} {odataV2>Employee/LastName}"
                                />
                                <Label
                                    id="lblEmpId"
                                    text="{i18n>employeeId}"
                                />
                                <Text
                                    id="txtEmpId"
                                    text="{odataV2>Employee/EmployeeID}"
                                />
                                <Label
                                    id="lblJobTitle"
                                    text="{i18n>jobTitle}"
                                />
                                <Text
                                    id="txtJobTitle"
                                    text="{odataV2>Employee/Title}"
                                />
                                <Label
                                    id="lblPhone"
                                    text="{i18n>phone}"
                                />
                                <Link
                                    id="lnkPhone"
                                    text="{odataV2>Employee/HomePhone}"
                                    href="tel:{odataV2>Employee/HomePhone}"
                                />

                                <core:Title
                                    id="pictureTitle"
                                    text="{i18n>picture}"
                                />
                                <Avatar
                                    id="employeeAvatar"
                                    displaySize="XL"
                                    displayShape="Square"
                                    initials="{
                                        parts: ['odataV2>Employee/FirstName', 'odataV2>Employee/LastName'],
                                        formatter: '.formatter.initials'
                                    }"
                                />
                            </form:SimpleForm>
                        </IconTabFilter>
                    </items>
                </IconTabBar>

                <Table
                    id="lineItemsTable"
                    class="sapUiResponsiveMargin"
                    width="auto"
                    items="{odataV2>Order_Details}"
                    updateFinished=".onLineItemsUpdateFinished"
                    visible="{= !${detailView>/editMode} }"
                >
                    <headerToolbar>
                        <Toolbar id="lineItemsToolbar">
                            <Title
                                id="lineItemsTitle"
                                text="{detailView>/lineItemsTitle}"
                            />
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column id="colProduct">
                            <Text
                                id="colProductText"
                                text="{i18n>product}"
                            />
                        </Column>
                        <Column
                            id="colUnitPrice"
                            hAlign="End"
                        >
                            <Text
                                id="colUnitPriceText"
                                text="{i18n>unitPrice}"
                            />
                        </Column>
                        <Column
                            id="colQuantity"
                            hAlign="End"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text
                                id="colQuantityText"
                                text="{i18n>quantity}"
                            />
                        </Column>
                        <Column
                            id="colTotal"
                            hAlign="End"
                        >
                            <Text
                                id="colTotalText"
                                text="{i18n>total}"
                            />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem id="lineItem">
                            <cells>
                                <ObjectIdentifier
                                    id="cellProduct"
                                    title="{odataV2>ProductName}"
                                    text="{odataV2>ProductID}"
                                />
                                <ObjectNumber
                                    id="cellUnitPrice"
                                    unit="EUR"
                                    number="{ path: 'odataV2>UnitPrice', type: 'sap.ui.model.type.Float', formatOptions: { minFractionDigits: 2, maxFractionDigits: 2 } }"
                                />
                                <Text
                                    id="cellQuantity"
                                    text="{odataV2>Quantity}"
                                />
                                <ObjectNumber
                                    id="cellTotal"
                                    unit="EUR"
                                    number="{ parts: ['odataV2>UnitPrice', 'odataV2>Quantity'], formatter: '.formatter.lineTotal' }"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
        <f:footer>
            <OverflowToolbar id="detailFooter">
                <ToolbarSpacer id="footerSpacer" />
                <Button
                    id="saveOrderButton"
                    type="Emphasized"
                    text="{i18n>save}"
                    press=".onSaveOrder"
                />
                <Button
                    id="cancelOrderButton"
                    text="{i18n>cancel}"
                    press=".onCancelOrder"
                />
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
